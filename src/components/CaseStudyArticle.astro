---
//@ts-nocheck
import DynamicImage from "@components/helpers/DynamicImage.astro";
import caseStudy from "@data/caseStudy.json";

const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<article class="case-study flow">
  <header class="case-study__header">
    <div class="case-study__hero-image">
      <DynamicImage imagePath={image} altText={caseName} />
    </div>

    <div class="case-details">
      <dl class="case-details__list">
        <div class="case-details__item">
          <dt class="case-details__label">Case Name</dt>
          <dd class="case-details__value">{caseName}</dd>
        </div>

        <div class="case-details__item">
          <dt class="case-details__label">Category</dt>
          <dd class="case-details__value">{category}</dd>
        </div>

        <div class="case-details__item">
          <dt class="case-details__label">Date</dt>
          <dd class="case-details__value">{date}</dd>
        </div>
      </dl>

      <a href="#0" class="case-details__button">{buttonLabel}</a>
    </div>
  </header>

  <div class="case-study__body flow">
    {
      caseStudy.sections.map((section, index) => (
        <section class="case-study__section flow">
          {index === 0 ? (
            <h2 class="case-study__title case-study__title--main">
              {section.title}
            </h2>
          ) : (
            <h3 class="case-study__title">{section.title}</h3>
          )}

          {Array.isArray(section.content) ? (
            <>
              {section.content.map((item) => (
                <p class="case-study__text">{item}</p>
              ))}
            </>
          ) : (
            <p class="case-study__text">{section.content}</p>
          )}

          {section.highlights && (
            <ul class="case-study__list flow">
              {section.highlights.map((highlight) => (
                <li class="case-study__list-item">{highlight}</li>
              ))}
            </ul>
          )}

          {section.image && (
            <div class="case-study__section-image">
              <DynamicImage
                imagePath={section.image}
                altText={section.title}
                width={600}
                height={400}
              />
            </div>
          )}
        </section>
      ))
    }
  </div>
</article>

<style>
  @layer components {
    .case-study {
      --flow-space: var(--space-3xl);
      width: min(100% - 2rem, var(--layout-max-width));
      margin-inline: auto;
      padding-block: var(--space-3xl) var(--space-4xl);
      color: var(--color-text);
    }

    .flow > * + * {
      margin-block-start: var(--flow-space, var(--space-s));
    }

    .case-study__header {
      position: relative;
      width: 100%;
      margin-inline: auto;
    }

    .case-study__hero-image {
      overflow: hidden;
      border-radius: var(--radius-m);
    }

    .case-study__hero-image :global(img),
    .case-study__hero-image :global(picture) {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }

    .case-details {
      width: min(100% - 5rem, 64rem);
      margin: -2.5rem auto 0;
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-l);
      padding: var(--space-l) var(--space-xl);
      border-radius: var(--radius-m);
      background: var(--color-ui-primary);
      color: var(--color-on-ui-primary);
    }

    .case-details__list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-l);
      margin: 0;
      padding: 0;
    }

    .case-details__item {
      display: grid;
      gap: var(--space-2xs);
    }

    .case-details__label {
      color: var(--color-on-ui-primary);
      font-family: var(--font-family-body);
      font-size: var(--step-small);
      font-weight: 600;
    }

    .case-details__value {
      color: var(--color-on-ui-primary-muted);
      font-family: var(--font-family-body);
      font-size: var(--step-small);
      margin: 0;
    }

    .case-details__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 2rem;
      border-radius: var(--radius-pill);
      background: var(--color-action);
      color: var(--color-ui-primary);
      font-family: var(--font-family-body);
      font-size: var(--step-small);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .case-details__button:hover,
    .case-details__button:focus-visible {
      background: #fbc336;
    }

    @supports (color: oklch(from red l c h)) {
      .case-details__button:hover,
      .case-details__button:focus-visible {
        background: oklch(from var(--color-action) calc(l - 0.06) c h);
      }
    }

    .case-study__body {
      --flow-space: var(--space-xl);
      width: min(100%, 46rem);
      margin-inline: auto;
    }

    .case-study__section {
      --flow-space: var(--space-s);
    }

    .case-study__title {
      margin: 0;
      color: var(--color-text);
      font-family: var(--font-family-heading);
      font-weight: 700;
      line-height: 1.3;
      font-size: var(--step-card-title);
    }

    .case-study__title--main {
      font-size: var(--step-h3);
    }

    .case-study__text {
      margin: 0;
      color: var(--color-text-muted);
      font-family: var(--font-family-body);
      font-size: var(--step-body);
      line-height: var(--line-height-body);
    }

    .case-study__list {
      --flow-space: var(--space-xs);
      padding-left: 1.25rem;
      margin-block-end: 0;
      color: var(--color-text-muted);
    }

    .case-study__list-item {
      color: var(--color-text-muted);
      font-family: var(--font-family-body);
      font-size: var(--step-body);
      line-height: var(--line-height-body);
    }

    .case-study__section-image {
      margin-block-start: var(--space-l);
    }

    .case-study__section-image :global(img),
    .case-study__section-image :global(picture) {
      width: min(100%, 44rem);
      margin-inline: auto;
      display: block;
      border-radius: var(--radius-xs);
      object-fit: cover;
    }

    @media (max-width: 48rem) {
      .case-study {
        padding-block: var(--space-2xl);
      }

      .case-details {
        width: min(100% - 1rem, 64rem);
        grid-template-columns: 1fr;
        padding: var(--space-m);
        margin-top: -1.5rem;
      }

      .case-details__list {
        grid-template-columns: 1fr;
        gap: var(--space-s);
      }

      .case-details__button {
        justify-self: start;
      }

      .case-study__body {
        width: 100%;
      }
    }
  }
</style>