<header class="header">
  <nav class="nav" aria-label="Primary navigation">
    <a href="/" class="logo">
      Ask<span>Experts</span>
    </a>

    <input class="menu-toggle" type="checkbox" id="menu-toggle" />

    <label class="hamburger" for="menu-toggle" aria-label="Open navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <div class="menu">
      <a href="/">Home</a>
      <a href="/case">Case Study</a>
      <a href="/employees">Team</a>
      <a href="/about">About</a>
    </div>

    <div class="login-wrapper">
      <input class="login-toggle" type="checkbox" id="login-toggle" />

      <label class="login-button" for="login-toggle">
        Login
      </label>

      <div id="login-menu" class="login-popover" popover>
        <label class="login-close" for="login-toggle" aria-label="Close login">
          ×
        </label>

        <h2>Dashboard Login</h2>

        <form>
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" />

          <label for="password">Password</label>
          <input type="password" id="password" name="password" />

          <button type="submit">Go to dashboard</button>
        </form>
      </div>
    </div>
  </nav>
</header>

<script>
  const loginToggle = document.querySelector("#login-toggle");

  if (loginToggle instanceof HTMLInputElement) {
    const updateScrollLock = () => {
      document.documentElement.classList.toggle("no-scroll", loginToggle.checked);
      document.body.classList.toggle("no-scroll", loginToggle.checked);
    };

    loginToggle.addEventListener("change", updateScrollLock);
  }
</script>

